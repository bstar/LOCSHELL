[Unit]
Description=mTCP game-save vault
After=network.target

[Service]
Type=simple
# Install dosctl on PATH and create a private token file before enabling.
# LAN clients require an explicit LAN address instead of the loopback default.
ExecStart=%h/.local/bin/dosctl saves serve --token-file %h/.local/share/locshell/saves.token
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
