@ECHO OFF
SET MTCPCFG=C:\LOCSHELL\NET\MTCP.CFG
C:\LOCSHELL\LOCHAND.EXE /RECOVER
IF ERRORLEVEL 4 GOTO FAIL
:MENU
C:
CD \LOCSHELL
C:\LOCSHELL\NET\AGENT\DOSAGENT.EXE C:\LOCSHELL\LOCSHELL.EXE
IF ERRORLEVEL 1 GOTO FAIL
C:
CD \LOCSHELL
C:\LOCSHELL\LOCHAND.EXE /CLAIM
IF ERRORLEVEL 4 GOTO BADREQ
IF ERRORLEVEL 3 GOTO RESTART
IF ERRORLEVEL 2 GOTO LEARN
IF ERRORLEVEL 1 GOTO RUN
GOTO END
:RUN
C:\LOCSHELL\LOCHAND.EXE /ENTER
CALL C:\LOCSHELL\RUN.BAT
IF ERRORLEVEL 1 GOTO NONZERO
C:\LOCSHELL\LOCHAND.EXE /RETURN 0
GOTO CLEAN
:NONZERO
C:\LOCSHELL\LOCHAND.EXE /RETURN 1
GOTO CLEAN
:LEARN
C:\LOCSHELL\LOCHAND.EXE /ENTER
C:\LOCSHELL\MEMWATCH.COM
IF ERRORLEVEL 1 GOTO LEARNERR
CALL C:\LOCSHELL\RUN.BAT
IF ERRORLEVEL 1 GOTO LEARNBAD
C:\LOCSHELL\MEMLEARN.EXE
C:\LOCSHELL\LOCHAND.EXE /RETURN 0
GOTO CLEAN
:LEARNBAD
C:\LOCSHELL\MEMLEARN.EXE
C:\LOCSHELL\LOCHAND.EXE /RETURN 1
GOTO CLEAN
:LEARNERR
C:\LOCSHELL\LOCHAND.EXE /FAIL
:CLEAN
C:
CD \LOCSHELL
IF EXIST C:\LOCSHELL\RUN.BAT DEL C:\LOCSHELL\RUN.BAT
:RESTART
C:\LOCSHELL\LOCHAND.EXE /RESUME
IF ERRORLEVEL 4 GOTO FAIL
GOTO MENU
:BADREQ
C:\LOCSHELL\LOCHAND.EXE /RECOVER
IF ERRORLEVEL 4 GOTO FAIL
GOTO MENU
:FAIL
ECHO LOC SHELL launch stopped. Review C:\LOCSHELL\LAUNCH.RES.
:END
C:
CD \LOCSHELL
