@ECHO OFF
SET MTCPCFG=C:\NET\MTCP.CFG
C:\DOSSHELL\LOCHAND.EXE /RECOVER
IF ERRORLEVEL 4 GOTO FAIL
:MENU
C:
CD \DOSSHELL
C:\NET\AGENT\DOSAGENT.EXE C:\DOSSHELL\LOCSHELL.EXE
IF ERRORLEVEL 1 GOTO FAIL
C:
CD \DOSSHELL
C:\DOSSHELL\LOCHAND.EXE /CLAIM
IF ERRORLEVEL 4 GOTO BADREQ
IF ERRORLEVEL 3 GOTO RESTART
IF ERRORLEVEL 2 GOTO LEARN
IF ERRORLEVEL 1 GOTO RUN
GOTO END
:RUN
C:\DOSSHELL\LOCHAND.EXE /ENTER
CALL C:\DOSSHELL\RUN.BAT
IF ERRORLEVEL 1 GOTO NONZERO
C:\DOSSHELL\LOCHAND.EXE /RETURN 0
GOTO CLEAN
:NONZERO
C:\DOSSHELL\LOCHAND.EXE /RETURN 1
GOTO CLEAN
:LEARN
C:\DOSSHELL\LOCHAND.EXE /ENTER
C:\DOSSHELL\MEMWATCH.COM
IF ERRORLEVEL 1 GOTO LEARNERR
CALL C:\DOSSHELL\RUN.BAT
IF ERRORLEVEL 1 GOTO LEARNBAD
C:\DOSSHELL\MEMLEARN.EXE
C:\DOSSHELL\LOCHAND.EXE /RETURN 0
GOTO CLEAN
:LEARNBAD
C:\DOSSHELL\MEMLEARN.EXE
C:\DOSSHELL\LOCHAND.EXE /RETURN 1
GOTO CLEAN
:LEARNERR
C:\DOSSHELL\LOCHAND.EXE /FAIL
:CLEAN
C:
CD \DOSSHELL
IF EXIST C:\DOSSHELL\RUN.BAT DEL C:\DOSSHELL\RUN.BAT
:RESTART
C:\DOSSHELL\LOCHAND.EXE /RESUME
IF ERRORLEVEL 4 GOTO FAIL
GOTO MENU
:BADREQ
C:\DOSSHELL\LOCHAND.EXE /RECOVER
IF ERRORLEVEL 4 GOTO FAIL
GOTO MENU
:FAIL
ECHO LOC SHELL launch stopped. Review C:\DOSSHELL\LAUNCH.RES.
:END
C:
CD \DOSSHELL
